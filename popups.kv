    height: 600
    width: 700
    auto_dismiss: False
    BoxLayout:
        id: comando_layout
        orientation:'vertical'
        size_hint_y: 0.9
        BoxLayout:
            orientation: 'horizontal'
            Label:
                text: "Ventilador"  
                pos_hint: {'top': 1.65,'right':0.5}     
            FloatLayout:
                        
                Label:
                    text: "Axial"
                    pos_hint: {'x':-1.3,'y': 0.5}
                #SelectButtonctButton:
