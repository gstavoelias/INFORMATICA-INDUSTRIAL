                    text: "Direta"
                    pos_hint: {'x':-1.3,'y': 0.5}
                #SelectButtonctButton:
                    pos_hint: {'x':-0.5,'y': 0.9} 
                    #on_release: app.root.sel_driver_direta()                   
                    
